{
  "name": "dsh-research-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p packages/research-agent/tsconfig.host.json && tsc --noEmit -p packages/research-agent/tsconfig.client.json",
    "test": "vitest run",
    "pack": "npm run build && npm pack ./packages/research-agent --pack-destination dist",
    "lint": "oxlint --type-aware --tsconfig tsconfig.lint.json packages/research-agent/src"
  },
  "dependencies": {
