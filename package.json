    "@deepseek-ai/schemastery": "3.18.5",
    "@napi-rs/canvas": "0.1.100",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "esbuild": "0.27.3",
    "js-yaml": "4.3.0",
    "lightningcss": "1.32.0",
    "pdfjs-dist": "5.4.624",
    "react": "18.3.1",
    "typescript": "6.0.3",
